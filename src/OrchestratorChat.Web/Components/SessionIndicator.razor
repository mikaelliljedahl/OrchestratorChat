@namespace OrchestratorChat.Web.Components
@inherits ComponentBase

<div class="d-flex align-center">
    @if (_currentSession != null)
    {
        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mr-2">
            @_currentSession.Name
        </MudChip>
        <MudText Typo="Typo.caption">Session Active</MudText>
    }
    else
    {
        <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="mr-2">
            No Session
        </MudChip>
    }
</div>